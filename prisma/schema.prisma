// Prisma schema for PostgreSQL database
// Baileys Store yapısına göre optimize edilmiş
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Multi-account için schema kullanımı (opsiyonel)
  // schemas  = ["public", "account_1767122031097", "account_1767122031098"]
}

// ============================================
// CHAT MODEL - Baileys KeyedDB yapısına uygun
// ============================================
model Chat {
  pkId                      Int      @id @default(autoincrement())
  sessionId                 String
  
  // Temel Bilgiler (Baileys store'dan)
  id                        String   // JID: "905335989539@s.whatsapp.net" veya "120363123456789012@g.us" (orijinal/raw)
  conversationTimestamp     BigInt?  // Son mesaj zamanı (Unix timestamp - saniye)
  
  // JID Format Alanları (jidConverter.ts için - arama ve eşleştirme için)
  jidNormalized             String?  // Normalize edilmiş JID (normalizeJid)
  jidStandardized            String?  // Standart JID (standardizeJid)
  phoneRaw                   String?  // Telefon numarası (raw, extractPhoneFromJid)
  phoneNormalized            String?  // Normalize edilmiş telefon (normalizePhoneNumber)
  phoneFormat                String?  // Format: 'turkish' | 'international' | 'unknown' (detectPhoneFormat)
  jidType                    String?  // JID tipi: 'user' | 'group' | 'newsletter' | 'broadcast' | 'lid' | 'unknown' (detectJidType)
  unreadCount               Int      @default(0)
  archived                  Boolean  @default(false)
  pinned                    BigInt?  // Sabitlenmiş mi? (timestamp)
  
  // İsim ve Görünüm
  name                      String?
  displayName               String?
  subject                   String?  // Grup konusu (grup chat'leri için)
  
  // Grup Bilgileri (sadece grup chat'leri için)
  // PostgreSQL JSONB - index'lenebilir!
  participant               Json?    // Participant JID'leri (JSON array)
  creation                  BigInt?  // Grup oluşturulma zamanı
  desc                      String?  // Grup açıklaması
  descOwner                 String?  // Açıklama sahibi
  descId                    String?  // Açıklama ID
  restrict                  Boolean? // Kısıtlı grup mu?
  announce                  Boolean? // Duyuru grubu mu?
  size                      Int?     // Grup üye sayısı
  ephemeralDuration         Int?     // Geçici mesaj süresi (saniye)
  inviteCode                String?  // Davet kodu
  
  // Mesaj Bilgileri
  lastMsgTimestamp          BigInt?
  messages                  Json?    // Chat içindeki mesajlar (genellikle boş, mesajlar ayrı tabloda)
  
  // Metadata
  imgUrl                    String?  // Profil resmi URL'si
  lidJid                    String?  // LID formatındaki JID (Linked ID)
  newJid                    String?  // Yeni JID (migration için)
  oldJid                    String?  // Eski JID (migration için)
  
  // Ayarlar
  muteEndTime               BigInt?  // Sessize alma bitiş zamanı
  disappearingMode          String?  // Geçici mesaj modu (JSON string)
  readOnly                  Boolean? // Salt okunur mu? (grup için)
  
  // Durum
  endOfHistoryTransfer      Boolean? // Geçmiş transferi tamamlandı mı?
  endOfHistoryTransferType  Int?
  markedAsUnread            Boolean? // Okunmadı olarak işaretlendi mi?
  unreadMentionCount        Int?     // Okunmamış mention sayısı
  
  // Diğer
  createdAt                 BigInt?
  createdBy                 String?  // Oluşturan JID
  contactPrimaryIdentityKey Bytes?   // Contact primary key
  tcToken                   Bytes?   // TC token
  tcTokenTimestamp          BigInt?   // TC token zamanı
  tcTokenSenderTimestamp    BigInt?  // TC token gönderen zamanı
  pHash                     String?  // pHash
  pnJid                     String?  // PN JID
  parentGroupId             String?  // Ana grup ID (subgroup için)
  isParentGroup             Boolean? // Ana grup mu?
  isDefaultSubgroup         Boolean? // Varsayılan alt grup mu?
  shareOwnPn                Boolean? // Kendi PN'yi paylaş
  pnhDuplicateLidThread     Boolean? // PNH duplicate LID thread
  support                   Boolean? // Destek chat'i mi?
  suspended                 Boolean? // Askıya alınmış mı?
  terminated                Boolean? // Sonlandırılmış mı?
  notSpam                   Boolean? // Spam değil mi?
  mediaVisibility           Int?     // Medya görünürlüğü
  wallpaper                 Json?    // Duvar kağıdı (JSON object)
  lastMessageRecvTimestamp  BigInt?  // Son mesaj alma zamanı

  @@unique([sessionId, id])
  @@index([sessionId])
  @@index([jidNormalized]) // Normalize edilmiş JID için index (arama performansı)
  @@index([jidStandardized]) // Standart JID için index
  @@index([phoneRaw]) // Telefon numarası için index (arama performansı)
  @@index([phoneNormalized]) // Normalize edilmiş telefon için index
  @@index([conversationTimestamp])
  @@index([archived])
  @@index([pinned])
  @@index([sessionId, conversationTimestamp]) // Composite index - chat listesi için
  @@map("chats")
}

// ============================================
// CONTACT MODEL - Baileys Record yapısına uygun
// ============================================
model Contact {
  pkId         Int     @id @default(autoincrement())
  sessionId    String
  id           String  // JID: "905335989539@s.whatsapp.net" (orijinal/raw)
  
  // JID Format Alanları (jidConverter.ts için - arama ve eşleştirme için)
  jidNormalized             String?  // Normalize edilmiş JID (normalizeJid)
  jidStandardized            String?  // Standart JID (standardizeJid)
  phoneRaw                   String?  // Telefon numarası (raw, extractPhoneFromJid)
  phoneNormalized            String?  // Normalize edilmiş telefon (normalizePhoneNumber)
  phoneFormat                String?  // Format: 'turkish' | 'international' | 'unknown' (detectPhoneFormat)
  jidType                    String?  // JID tipi: 'user' | 'group' | 'newsletter' | 'broadcast' | 'lid' | 'unknown' (detectJidType)
  
  // İsim Bilgileri
  name         String?
  notify       String? // Bildirim adı
  verifiedName String? // Doğrulanmış isim (ticari hesaplar için)
  
  // Profil
  imgUrl       String? // Profil resmi URL'si
  status       String? // Durum mesajı
  
  // Metadata (PostgreSQL JSONB)
  vcard        Json?   // vCard verisi (JSON object)
  businessProfile Json? // İş profili (JSON object)
  labels       Json?   // Etiketler (JSON array)

  @@unique([sessionId, id])
  @@index([sessionId])
  @@index([jidNormalized]) // Normalize edilmiş JID için index (arama performansı)
  @@index([jidStandardized]) // Standart JID için index
  @@index([phoneRaw]) // Telefon numarası için index (arama performansı)
  @@index([phoneNormalized]) // Normalize edilmiş telefon için index
  @@index([verifiedName])
  @@map("contacts")
}

// ============================================
// MESSAGE MODEL - Baileys Record<string, Message[]> yapısına uygun
// ============================================
model Message {
  pkId                            Int      @id @default(autoincrement())
  sessionId                       String
  remoteJid                       String   // Chat JID: "905335989539@s.whatsapp.net" (orijinal/raw)
  id                              String   // Mesaj ID
  
  // JID Format Alanları (jidConverter.ts için - arama ve eşleştirme için)
  remoteJidNormalized             String?  // Normalize edilmiş remoteJid (normalizeJid)
  remoteJidStandardized           String?  // Standart remoteJid (standardizeJid)
  remoteJidPhoneRaw               String?  // Telefon numarası (raw, extractPhoneFromJid)
  remoteJidPhoneNormalized        String?  // Normalize edilmiş telefon (normalizePhoneNumber)
  remoteJidPhoneFormat            String?  // Format: 'turkish' | 'international' | 'unknown'
  remoteJidType                   String?  // JID tipi: 'user' | 'group' | 'newsletter' | 'broadcast' | 'lid' | 'unknown'
  
  // Key Bilgileri (PostgreSQL JSONB - index'lenebilir!)
  key                             Json     // { remoteJid, fromMe, id, participant }
  
  // Mesaj İçeriği (PostgreSQL JSONB - index'lenebilir!)
  message                         Json?    // Message content (conversation, imageMessage, vb.)
  
  // Metadata
  messageTimestamp                BigInt?  // Mesaj zamanı (Unix timestamp - saniye)
  messageC2STimestamp             BigInt?  // C2S timestamp
  pushName                        String?  // Gönderen adı
  participant                     String?  // Participant JID (grup mesajları için) (orijinal/raw)
  
  // Participant JID Format Alanları (jidConverter.ts için)
  participantNormalized           String?  // Normalize edilmiş participant JID
  participantPhoneRaw              String?  // Participant telefon numarası (raw)
  participantPhoneNormalized       String?  // Normalize edilmiş participant telefon
  participantPhoneFormat           String?  // Participant format: 'turkish' | 'international' | 'unknown'
  
  broadcast                       Boolean? @default(false)
  multicast                       Boolean? @default(false)
  status                          Int?     // Mesaj durumu (0: pending, 1: server_ack, 2: delivery, 3: read)
  starred                         Boolean? @default(false)
  isForwarded                      Boolean? @default(false) // Mesaj iletildi mi? (forward edildi mi?)
  
  // Reaction'lar (PostgreSQL JSONB - index'lenebilir!)
  reactions                       Json?    // Reaction array (JSON)
  
  // Protocol Mesajları
  messageStubType                 Int?     // Protocol mesaj tipi (0: REVOKE, 1: CIPHERTEXT, vb.)
  messageStubParameters           Json?    // Protocol mesaj parametreleri (JSON array)
  
  // Medya Bilgileri
  mediaData                       Json?    // Medya verisi (JSON object)
  mediaCiphertextSha256           Bytes?
  duration                        Int?     // Ses/video süresi (saniye)
  fileLength                      BigInt?  // Dosya boyutu
  
  // Ephemeral (Geçici Mesajlar)
  ephemeralDuration               Int?     // Geçici mesaj süresi
  ephemeralOffToOn                Boolean?
  ephemeralOutOfSync              Boolean?
  ephemeralStartTimestamp         BigInt?
  
  // Diğer
  agentId                         String?
  bizPrivacyStatus                Int?
  clearMedia                      Boolean?
  futureproofData                 Bytes?
  ignore                          Boolean?
  keepInChat                      Json?    // Keep in chat (JSON object)
  labels                          Json?    // Labels (JSON array)
  messageSecret                   Bytes?
  originalSelfAuthorUserJidString String?
  paymentInfo                     Json?    // Payment info (JSON object)
  photoChange                     Json?    // Photo change (JSON object)
  pollAdditionalMetadata          Json?    // Poll metadata (JSON object)
  pollUpdates                     Json?    // Poll updates (JSON object)
  quotedPaymentInfo               Json?    // Quoted payment (JSON object)
  quotedStickerData               Json?    // Quoted sticker (JSON object)
  revokeMessageTimestamp          BigInt?  // Revoke timestamp
  statusAlreadyViewed             Boolean?
  statusPsa                       Json?    // Status PSA (JSON object)
  urlNumber                       Boolean?
  urlText                         Boolean?
  userReceipt                     Json?    // User receipt (JSON object)
  verifiedBizName                 String?
  finalLiveLocation               Json?    // Final live location (JSON object)

  @@unique([sessionId, remoteJid, id])
  @@index([sessionId])
  @@index([remoteJid])
  @@index([remoteJidNormalized]) // Normalize edilmiş JID için index (arama performansı)
  @@index([remoteJidPhoneRaw]) // Telefon numarası için index (arama performansı)
  @@index([remoteJidPhoneNormalized]) // Normalize edilmiş telefon için index
  @@index([sessionId, remoteJid]) // Composite index - chat bazında mesaj sorguları için
  @@index([messageTimestamp])
  @@index([status])
  @@index([starred])
  @@index([participant]) // Grup mesajları için
  @@index([participantNormalized]) // Normalize edilmiş participant için index
  // PostgreSQL JSONB index'leri (migration'da eklenecek)
  // CREATE INDEX idx_message_type ON messages USING GIN ((message->>'type'));
  // CREATE INDEX idx_message_reactions ON messages USING GIN (reactions);
  @@map("messages")
}

// ============================================
// GROUP METADATA MODEL
// ============================================
model GroupMetadata {
  pkId              Int     @id @default(autoincrement())
  sessionId         String
  id                String  // Grup JID
  
  owner             String? // Grup sahibi JID
  subject           String  // Grup konusu
  subjectOwner      String? // Konu sahibi JID
  subjectTime       BigInt? // Konu zamanı
  creation          BigInt? // Oluşturulma zamanı
  desc              String? // Açıklama
  descOwner         String? // Açıklama sahibi
  descId            String? // Açıklama ID
  restrict          Boolean? // Kısıtlı grup mu?
  announce          Boolean? // Duyuru grubu mu?
  size              Int?     // Üye sayısı
  
  // Participants (PostgreSQL JSONB - index'lenebilir!)
  participants      Json     // Participant array (JSON)
  
  ephemeralDuration Int?     // Geçici mesaj süresi
  inviteCode        String?  // Davet kodu

  @@unique([sessionId, id])
  @@index([sessionId])
  @@index([subject])
  @@map("group_metadata")
}

// ============================================
// SESSION MODEL (Auth için)
// ============================================
model Session {
  pkId      Int    @id @default(autoincrement())
  sessionId String
  id        String
  data      String // Session data

  @@unique([sessionId, id])
  @@index([sessionId])
  @@map("sessions")
}

// ============================================
// MESSAGE TEMPLATE MODEL
// ============================================
model MessageTemplate {
  pkId        Int      @id @default(autoincrement())
  sessionId   String   // Hangi session'a ait (opsiyonel, tüm hesaplar için kullanılabilir)
  id          String   @unique // Unique template ID
  name        String   // Şablon adı
  type        String   // 'button' | 'list' | 'template' | 'product'
  data        Json     // JSON string olarak şablon verisi (PostgreSQL JSONB)
  createdAt   BigInt   // Timestamp (milliseconds)
  updatedAt   BigInt?  // Timestamp (milliseconds)

  @@index([sessionId])
  @@index([type])
  @@map("message_templates")
}

