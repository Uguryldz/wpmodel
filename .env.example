# Database
# PostgreSQL veritabanı bağlantı bilgileri
# Format: postgresql://user:password@host:port/database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/wpmodel"

# Server
# Backend API sunucusunun çalışacağı port
PORT=3000

# Frontend Port
# Vite development server'ın çalışacağı port
VITE_PORT=5173

# Backend URL (Frontend için)
# Frontend'den backend'e istek yaparken kullanılacak URL
# Eğer proxy kullanıyorsanız, bu değeri boş bırakabilirsiniz (Vite proxy otomatik yönlendirir)
# Production'da veya farklı bir sunucuda çalıştırırken tam URL gerekebilir
# Örnek: VITE_BACKEND_URL=http://localhost:3000
VITE_BACKEND_URL=

# WebSocket URL (Frontend için)
# WebSocket bağlantısı için kullanılacak URL
# Boş bırakılırsa, window.location.host kullanılır (önerilen)
# Örnek: VITE_WS_URL=ws://localhost:3000
VITE_WS_URL=

# Logging
# Log seviyesi: error, warn, info, debug
LOG_LEVEL=debug

# Node Environment
# Development veya production
NODE_ENV=development
